{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardagent.local/schemas/sanitization-event.schema.json",
  "title": "GuardAgent sanitization event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "sanitizer_event_id", "direction", "session_key", "tool_name", "classifications", "transformations", "original_size", "result_size", "truncated", "blocked"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "sanitizer_event_id": {"type": "string"},
    "direction": {"enum": ["inbound", "outbound"]},
    "session_key": {"type": "string"},
    "tool_name": {"type": "string"},
    "tool_call_id": {"type": ["string", "null"]},
    "classifications": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "transformations": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["json_path", "classification", "length", "source", "proposed_action", "ref"],
        "properties": {
          "json_path": {"type": "string", "maxLength": 1024},
          "classification": {"type": "string", "maxLength": 128},
          "length": {"type": "integer", "minimum": 0},
          "source": {"type": "string", "maxLength": 128},
          "proposed_action": {"enum": ["preserve", "redact", "drop", "late_bind", "block", "require_approval"]},
          "ref": {"type": "string", "maxLength": 128}
        }
      }
    },
    "original_size": {"type": "integer", "minimum": 0},
    "result_size": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"},
    "blocked": {"type": "boolean"},
    "pattern_digest": {"type": ["string", "null"]},
    "content_digest": {"type": ["string", "null"]}
  }
}
