{
  "id": "guard-openclaw",
  "activation": {
    "onStartup": true
  },
  "name": "GuardAgent OpenClaw Guard",
  "description": "Fail-closed local policy enforcement and audit hooks for OpenClaw",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["serviceUrl", "tokenFile", "workspaceRoot"],
    "properties": {
      "serviceUrl": {"type": "string", "pattern": "^https?://(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]+)?$"},
      "tokenFile": {"type": "string", "minLength": 1},
      "workspaceRoot": {"type": "string", "minLength": 1},
      "timeoutMs": {"type": "integer", "minimum": 50, "maximum": 450},
      "gatewayId": {"type": "string", "minLength": 1},
      "observeInputInjection": {"type": "boolean"},
      "captureTaskPolicy": {"type": "boolean"},
      "sanitizationMode": {"type": "string", "enum": ["disabled", "observe", "enforce"], "default": "observe"},
      "contentInspectionMode": {"type": "string", "enum": ["disabled", "observe", "enforce"], "default": "observe"},
      "skillRoots": {"type": "array", "items": {"type": "string"}, "maxItems": 32}
    }
  },
  "uiHints": {
    "tokenFile": {"label": "Bearer token file", "sensitive": true},
    "serviceUrl": {"label": "guardd loopback URL"},
    "workspaceRoot": {"label": "Authorized workspace root"},
    "timeoutMs": {"label": "Decision timeout (ms)", "advanced": true},
    "captureTaskPolicy": {"label": "Capture session task policy objectives", "advanced": true},
    "sanitizationMode": {"label": "Data-path sanitization", "help": "Observe records detections; enforce transforms tool data and blocks unsafe outbound secrets."},
    "contentInspectionMode": {"label": "Skill/MCP inspection", "help": "Enforce fails closed for uninspected content identities."},
    "skillRoots": {"label": "Skill roots", "help": "Optional directories whose direct child Skills are rescanned at Gateway startup.", "advanced": true}
  }
}
